{
  "name": "@contextflow/qnx-companion",
  "version": "0.1.0",
  "description": "ContextFlow QNX Companion CLI - Analyze QNX 8.0 projects, invoke the QNX compiler, and generate structured diagnostic reports",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "contextflow-qnx": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
